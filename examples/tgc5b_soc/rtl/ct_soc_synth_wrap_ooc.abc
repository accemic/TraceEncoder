#
# Out-of-context synthesis target for the bare example SoC (`make
# impl-tgc5b-soc`, Kria KV260 / xck26 utilization + timing estimate).
# Kept separate from the ct_soc_synth_wrap library .abc: a `build` there
# would also fire in every flow that merely imports the SoC (e.g. the
# KV260 app bitstream build).

import @examples/tgc5b_soc/rtl : ct_soc_synth_wrap

constraints -top impl [resolve ct_soc_synth_wrap_kv260.xdc]

build ct_soc_synth_wrap
