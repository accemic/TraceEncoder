#
# KV260 app bitstream, pure abc flow (no block design):
#
#   cd bld && abc -new -bitgen ../examples/tgc5b_soc/fpga/kv260/ct_soc_kv260.abc
#
# The Zynq PS and the AXI plumbing IPs are generated as standalone XCIs by
# gen_ip.tcl and instantiated from ct_soc_kv260_top.sv; the SoC itself comes in
# through the ct_soc_top import (the same dependency graph the simulation
# builds). create_bitfile.sh wraps this and packages the loadable app.

set_property part       xck26-sfvc784-2LV-c            [current_project]
set_property BOARD_PART xilinx.com:kv260_som:part0:1.3 [current_project]

if { [version -short] != "2022.1" } {
	puts "ct_soc_kv260.abc: unsupported Vivado version [version -short] (need 2022.1)"
	exit 1
}

import @examples/tgc5b_soc : ct_soc_top

source [resolve gen_ip.tcl]

# Single-clock design: every encoder-internal clock is tied to pl_clk0, so the
# module-scoped CDC constraint files that ride in with the imports (max_delay /
# false_path between what are here identical clocks) must not be applied —
# all paths are regular same-clock paths. Several of their pin patterns also
# match nothing once single-clock optimization removes the synchronizer
# structures, which would error the run. The former block-design flow included
# none of these files either.
foreach cdc_xdc {
	cross_reset.xdc fifo2clk_fwft.xdc reset_cdc.xdc signal_cdc.xdc
	ocram_sdp.xdc ct_cs_cpuif_wb.xdc
} {
	set f [get_files -quiet "*/$cdc_xdc"]
	if {[llength $f]} { set_property IS_ENABLED 0 $f }
}

read_sv ct_soc_kv260_top.sv
build   ct_soc_kv260_top
