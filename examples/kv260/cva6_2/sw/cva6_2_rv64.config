# Kernel fragment: the AMP guest (two CVA6 cores, examples/kv260/cva6_2).
#
# Identical to cva6_rv64.config, plus ONE line -- see the end of the file.
#
# The kernel defconfig is NOT rv64_defconfig but arch/riscv/configs/defconfig --
# that one IS the 64-bit variant (base-ISA choice "default ARCH_RV64I",
# arch/riscv/Kconfig; an rv64_defconfig target does not exist in
# arch/riscv/Makefile). The driver set is therefore the same as in the RV32
# stage (rv32_defconfig = defconfig + 32-bit.config) -- deliberate parity, no
# re-cut.
#
# 1) The C extension STAYS ON. The target core has it: CVA6ConfigCExtEn = 1
#    (cv64a6_imac_sv39_ctrace_config_pkg.sv:53), passed through as
#    RVC: bit'(CVA6ConfigCExtEn) (:132). That is the difference to the
#    RV32 stage -- there C was absent from the core and had to be switched off
#    in the kernel, otherwise the core takes an illegal instruction at the
#    first c.*. Here a kernel without C would run (C is a superset), but it
#    would decouple the configuration from the hardware for no reason.
# 2) No FPU in the core: CVA6ConfigRVF/RVD = 0 (:45-46, cvfpu is generated
#    away). CONFIG_FPU is "default y" per Kconfig
#    (arch/riscv/Kconfig, config FPU) and MUST therefore be removed explicitly
#    here -- without this line the kernel builds in FP context saving and dies
#    at the first fsd in a task switch.
# CONFIG_FPU is not set
# 3) Console: generic 8250 MMIO window, POLLED (no PLIC in the design).
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_HVC_RISCV_SBI=y
# 4) NONPORTABLE has to come BEFORE the EFI switch -- otherwise it has no
#    effect at all. "config PORTABLE" carries "default !NONPORTABLE" and a
#    "select EFI" (arch/riscv/Kconfig, config PORTABLE). The RV32 route got
#    NONPORTABLE for free: arch/riscv/configs/32-bit.config sets it as well,
#    which is why the EFI line alone was enough there. The 64-bit path (plain
#    defconfig) has no such fragment -- without the two lines here
#    CONFIG_PORTABLE=y stays, pulls EFI back in via select, and the
#    "# CONFIG_EFI is not set" below is silently overruled (measured exactly
#    like that in the first run on 2026-08-08: CONFIG_EFI=y despite the
#    fragment). NONPORTABLE changes nothing by itself, it only unlocks the
#    options that yield an SoC-specific kernel -- and that is precisely what
#    this is.
CONFIG_NONPORTABLE=y
# CONFIG_PORTABLE is not set
# 5) No EFI stub: we jump straight into the kernel. CONFIG_EFI is "default y"
#    per Kconfig and selects the generic stub. Side effect -- without the
#    PE/COFF header the image no longer contains data bytes that a
#    disassembler reads as instructions (finding 2026-07-26 from the RV32
#    stage). EFI additionally drags in ARCH_SUPPORTS_ACPI/ACPI (only on
#    64BIT) -- dead weight on a pure DT SoC.
# CONFIG_EFI is not set
# CONFIG_EFI_STUB is not set
# 6) initramfs inside the image (load one artefact instead of three).
CONFIG_BLK_DEV_INITRD=y
# 7) Keep it small: no network-stack ballast during bring-up.
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
#
# Sv39 is deliberately NOT here: Linux 6.12 no longer has a Kconfig switch for
# it, it picks the satp mode at run time instead (arch/riscv/mm/init.c,
# set_satp_mode). Sv39 is forced through the boot argument "no4lvl" in
# cva6_kv260_rv64.dts -- which is read from the DTB before any paging
# (__pi_set_satp_mode_from_cmdline, arch/riscv/kernel/pi/cmdline_early.c:43)
# and switches L4+L5 off WITHOUT the satp read-back attempt that is otherwise
# customary.

# 8) NO loadable modules -- this is the delta against the single-core guest.
#    arch/riscv/configs/defconfig builds 340 symbols as `=m`; Buildroot then
#    installs 23 MiB of them into /lib/modules INSIDE the initramfs. On this
#    SoC nothing ever loads them: no removable hardware, no storage stack, no
#    network -- the console is the memory-mapped 8250 above, and that is
#    already built in (see 3).
#    Measured on the build host 2026-08-20: target/lib/modules = 23 MiB of a
#    29 MiB rootfs; the resulting payload was 31.07 MiB against a 32 MiB
#    window -- 0.93 MiB of headroom for a devicetree that OpenSBI relocates
#    to the END of that window. That is the whole defect of the AMP demo.
#    Turning modules off does not remove a capability that is used; it
#    removes one that cannot be used here.
# CONFIG_MODULES is not set

# 9) The driver classes that (8) promoted from `=m` to `=y`. Measured, not
#    guessed: with (8) alone the kernel grew by 7.5 MiB and the build log
#    showed drivers/gpu/drm/nouveau being compiled into a guest that has no
#    GPU. The AMP guest needs exactly three things -- the memory-mapped 8250
#    from (3), the initramfs from (6), and the SBI timer. Everything below is
#    hardware this SoC does not have.
# CONFIG_PCI is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_MMC is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_NETDEVICES is not set
# CONFIG_WLAN is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_VIRTIO_MENU is not set

# 10) FLATMEM instead of SPARSEMEM. Measured on the board 2026-08-20: with
#     SPARSEMEM_EXTREME the guest dies in sparse_init with
#     "memblocks_present: Failed to allocate 16777216 bytes align=0x40" --
#     the section root table is sized from MAX_PHYSMEM_BITS (56 bit), not
#     from the 32 MiB this guest actually has. Checked first, and not the
#     cause: the mailbox reserved-memory node (moved to /soc as a device
#     node; the "OF: reserved mem" line disappears, the panic does not).
#     One contiguous window is exactly the case FLATMEM is for.
# CONFIG_SPARSEMEM_MANUAL is not set
CONFIG_FLATMEM_MANUAL=y

# 11) Size, second pass. Measured 2026-08-20: with FLATMEM the guest reaches
#     userspace init and then dies with "System is deadlocked on memory" in
#     io_uring_init -- 32 MiB total against a 17.7 MiB kernel and a 6.4 MiB
#     initramfs. None of the following exists on this SoC or is used by this
#     demo, and all of it is built IN, not modular.
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_IO_URING is not set
# CONFIG_NET is not set
# CONFIG_EXT4_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_9P_FS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_QUOTA is not set
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_PROFILING is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_VM_PGTABLE is not set
# CONFIG_MEMTEST is not set
# CONFIG_CRYPTO_USER_API is not set
# CONFIG_XZ_DEC is not set
