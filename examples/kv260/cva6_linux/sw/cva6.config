# Kernel fragment: CVA6 cv32a6_ima_sv32_fpga
# 1) The core has NO C extension -> the kernel must not emit compressed
#    instructions. Without this, the core takes an illegal-instruction trap
#    on the first c.*.
# CONFIG_RISCV_ISA_C is not set
# 2) No FPU in the core.
# CONFIG_FPU is not set
# 3) Console: generic 8250 MMIO window, POLLED (no PLIC in the design).
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_HVC_RISCV_SBI=y
# 4) No EFI stub: we jump directly into the kernel. Side effect -- without a
#    PE/COFF header the image no longer contains data bytes that a
#    disassembler would read as compressed instructions.
# CONFIG_EFI is not set
# CONFIG_EFI_STUB is not set
# 5) initramfs embedded in the Image (one artifact to load instead of three).
CONFIG_BLK_DEV_INITRD=y
# 6) Keep it small: no network-stack ballast during bring-up.
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
