#
# Kernel fragment: CVA6 cv64a6_imac_sv39_ctrace
#
# Counterpart to cva6.config (RV32, in ../../cva6_linux/sw/). The base
# here is NOT rv32_defconfig, but arch/riscv/configs/defconfig -- that IS
# the 64-bit variant (base ISA choice "default ARCH_RV64I",
# arch/riscv/Kconfig; there is no rv64_defconfig target in
# arch/riscv/Makefile). The driver set is therefore the same as in the
# RV32 stage (rv32_defconfig = defconfig + 32-bit.config) -- deliberate
# parity, not a redesign.
#
# 1) The C extension STAYS ON. The target core has it: CVA6ConfigCExtEn = 1
#    (cv64a6_imac_sv39_ctrace_config_pkg.sv), passed through as
#    RVC: bit'(CVA6ConfigCExtEn). This is the difference to the RV32 stage
#    -- there C was missing in the core and had to be turned off in the
#    kernel, otherwise the core takes an illegal-instruction trap on the
#    first c.*. Here a kernel without C would still run (C is a superset),
#    but would decouple the configuration from the hardware for no reason.
# 2) No FPU in the core: CVA6ConfigRVF/RVD = 0 (cvfpu generated away).
#    CONFIG_FPU is "default y" via Kconfig (arch/riscv/Kconfig, config FPU)
#    and MUST therefore be explicitly turned off here -- without this line
#    the kernel builds in FP context save/restore and dies on the first
#    fsd during a task switch.
# CONFIG_FPU is not set
# 3) Console: generic 8250 MMIO window, POLLED (no PLIC in the design).
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_HVC_RISCV_SBI=y
# 4) NONPORTABLE must come BEFORE the EFI switch -- otherwise it does not
#    take effect. "config PORTABLE" has "default !NONPORTABLE" and a
#    "select EFI" (arch/riscv/Kconfig, config PORTABLE). The RV32 path got
#    NONPORTABLE for free: arch/riscv/configs/32-bit.config sets it along
#    the way, and the EFI line alone was therefore enough there. The
#    64-bit path (plain defconfig) has no such fragment -- without these
#    two lines here, CONFIG_PORTABLE=y stays, pulls EFI back in via select,
#    and the "# CONFIG_EFI is not set" below gets silently overridden
#    (measured exactly like this on the first run: CONFIG_EFI=y despite the
#    fragment). NONPORTABLE by itself changes nothing, it only unlocks the
#    options that make an SoC-specific kernel -- and that is exactly what
#    this is.
CONFIG_NONPORTABLE=y
# CONFIG_PORTABLE is not set
# 5) No EFI stub: we jump directly into the kernel. CONFIG_EFI is "default
#    y" via Kconfig and selects the generic stub. Side effect -- without a
#    PE/COFF header the image no longer contains data bytes that a
#    disassembler would read as instructions (same finding as in the RV32
#    stage). EFI additionally pulls in ARCH_SUPPORTS_ACPI/ACPI (64-bit
#    only) -- dead weight on a pure DT SoC.
# CONFIG_EFI is not set
# CONFIG_EFI_STUB is not set
# 6) initramfs embedded in the Image (one artifact to load instead of three).
CONFIG_BLK_DEV_INITRD=y
# 7) Keep it small: no network-stack ballast during bring-up.
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
#
# Sv39 is deliberately NOT here: Linux 6.12 no longer has a Kconfig switch
# for this, but chooses the satp mode at runtime (arch/riscv/mm/init.c,
# set_satp_mode). Sv39 is forced via the bootarg "no4lvl" in
# cva6_kv260_rv64.dts -- read from the DTB before any paging
# (__pi_set_satp_mode_from_cmdline, arch/riscv/kernel/pi/cmdline_early.c:43)
# and disables L4+L5, WITHOUT the otherwise usual satp read-back attempt.
