#
# Red counter-proof job (Klasse 9 / Gate 14): BMC on the P-SYNC-1-only
# build (sv2v -DRED_CLASS9). Run by run_red.sh twice:
#   - against the CURRENT RTL      -> must PASS (green cross-check)
#   - against the pre-fix worktree -> must FAIL (the resume-anchor race)

[options]
mode bmc
depth 80

[engines]
smtbmc yices

[script]
read -formal preproc_sync_red.v
prep -top f_preproc_check

[files]
build/preproc_sync_red.v
