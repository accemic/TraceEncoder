#
# Provenance record of the KV260 demo bundle series.
#
# The ready-to-load demo apps are TRACKED IN THIS REPOSITORY, one per demo
# under examples/kv260/<demo>/fpga/prebuilt/<app>/ -- there is nothing to
# fetch. Each prebuilt directory was extracted verbatim from one bundle of
# the board-gated series below; its per-file MANIFEST.sha256 verifies the
# extracted set, and this file records which series those bundles were and
# the sha256 of each deterministic tarball (package_kv260_app.py --bundle),
# so the extraction can be re-audited against the archived bundles.
#
# ABOUT THE VERSION. `vX.Y.Z-demoN` is the version of the DEMO SERIES, not of
# the encoder: a series is rebuilt whenever a bundle's inputs change (a fixed
# board script, a re-vendored core), and N counts those rebuilds. It does not
# have to equal the number in VERSION -- the encoder RTL inside a bundle is
# whatever commit its build log names, and that is recorded in the bundle's
# own provenance file.

version  = v1.0.1-demo2

# sha256 per bundle tarball <app>-<version>.tar.gz of the series above.
sha256.cva6_2_rv32_ctrace_kv260         = 1c5cb8849b579f6a91489e545c99a5b2d5b94a77d7eb2c24311f7bfaeffe24d7
